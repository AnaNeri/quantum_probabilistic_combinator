cabal-version:       >=1.10
name:                QuantumProbabilisticCombinators
version:             0.1.0.0
build-type:          Simple

library
  exposed-modules:     Matrices, ProbabilisticCombinator
  hs-source-dirs:      src
  build-depends:       base >=4.14 && <5, containers, matrix, random
  default-language:    Haskell2010

executable tests
  main-is:             tests.hs
  hs-source-dirs:      src
  build-depends:       base >=4.14 && <5, containers, directory, matrix, random, QuantumProbabilisticCombinators
  default-language:    Haskell2010